{
  "name": "web-server",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && webpack --mode=production",
    "build:server": "tsc",
    "build:client": "webpack --mode=production",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "dev:nodemon": "nodemon --exec ts-node src/app.ts",
    "dev:client": "webpack serve --mode=development",
    "dev:watch": "webpack --mode=development --watch",
    "dev:full": "concurrently \"npm run dev:nodemon\" \"npm run dev:watch\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "express": "^5.1.0",
    "hbs": "^4.2.0",
    "postman-request": "^2.88.1-postman.43"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/hbs": "^4.0.5",
    "@types/node": "^20.10.0",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.5.3",
    "nodemon": "^3.1.10",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
